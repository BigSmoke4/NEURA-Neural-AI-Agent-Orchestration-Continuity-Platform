# Copy to .env and create this local-development secret outside Git.
# The development container runs as UID 10001, so this disposable local DB secret
# must be readable by that UID. Never use this permissive mode in production.
# Example: mkdir -p secrets && openssl rand -base64 32 > secrets/postgres_password && chmod 644 secrets/postgres_password
POSTGRES_PASSWORD_FILE=./secrets/postgres_password

# Optional registration codes. Leave blank to allow only the User role at signup.
NEURA_OPERATOR_REGISTRATION_CODE=
NEURA_AUDITOR_REGISTRATION_CODE=
NEURA_ADMIN_REGISTRATION_CODE=

# Host ports are bound to loopback only (for local development/reverse proxy).
POSTGRES_HOST_PORT=5433
WEB_HOST_PORT=8081
