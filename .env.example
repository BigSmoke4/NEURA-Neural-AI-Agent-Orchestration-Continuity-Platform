# Copy to .env in the repo root (docker-compose reads it automatically).
# Never commit the real .env file.
POSTGRES_PASSWORD=change_me

# Optional registration codes. Leave blank to allow only the User role at signup.
NEURA_OPERATOR_REGISTRATION_CODE=
NEURA_AUDITOR_REGISTRATION_CODE=
NEURA_ADMIN_REGISTRATION_CODE=

# Host port for Docker PostgreSQL (container remains on 5432).
POSTGRES_HOST_PORT=5433
