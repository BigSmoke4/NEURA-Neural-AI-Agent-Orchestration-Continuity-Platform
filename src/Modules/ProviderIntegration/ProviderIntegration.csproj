<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Neura.Modules.ProviderIntegration</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- IHttpClientFactory (used by ProviderFactory) lives in this package.
         Web.csproj gets it for free via the ASP.NET Core shared framework
         (Microsoft.NET.Sdk.Web), but this is a plain class library, so it
         needs the package explicitly. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.20" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Shared/Shared.csproj" />
  </ItemGroup>
</Project>
