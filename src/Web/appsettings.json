{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=neura;Username=neura;Password=CHANGE_ME"
  },
  "Neura": {
    "Mode": "Simulation",
    "ContextThresholds": {
      "WarningThreshold": 0.7,
      "CriticalThreshold": 0.85,
      "ExhaustionThreshold": 0.95
    },
    "Registration": {
      "RoleCodes": {
        "Operator": "SET_OPERATOR_REGISTRATION_CODE",
        "Auditor": "SET_AUDITOR_REGISTRATION_CODE",
        "Admin": "SET_ADMIN_REGISTRATION_CODE"
      }
    }
  },
  "AllowedHosts": "*"
}
