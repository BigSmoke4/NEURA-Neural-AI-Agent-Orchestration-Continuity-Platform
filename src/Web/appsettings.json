{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=neura;Username=neura;Password=CHANGE_ME"
  },
  "Neura": {
    "ContextThresholds": {
      "WarningThreshold": 0.7,
      "CriticalThreshold": 0.85,
      "ExhaustionThreshold": 0.95
    },
    "MissionRecovery": {
      "HeartbeatIntervalSeconds": 20,
      "StaleRunningTimeoutSeconds": 300,
      "RecoverySweepIntervalSeconds": 30,
      "MaxMissionsPerSweep": 100
    }
  },
  "AllowedHosts": "*"
}
