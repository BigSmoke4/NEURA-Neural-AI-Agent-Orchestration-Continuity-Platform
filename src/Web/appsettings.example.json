{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=neura;Username=neura;Password=your_password_here"
  },
  "Neura": {
    "Mode": "Real",
    "DataProtectionKeyPath": "/var/neura/dp-keys",
    "NotifyEmailAddress": "ops@your-company.example",
    "Smtp": {
      "Host": "smtp.your-provider.example",
      "Port": 587,
      "Username": "apikey-or-username",
      "Password": "store via user-secrets / key vault, never commit",
      "FromAddress": "neura-alerts@your-company.example",
      "EnableSsl": true
    },
    "ModelPricing": {
      "Models": {
        "claude-opus-5": {
          "InputPer1k": 0.015,
          "OutputPer1k": 0.075
        },
        "gpt-5": {
          "InputPer1k": 0.005,
          "OutputPer1k": 0.015
        }
      }
    },
    "OAuth": {
      "Google": {
        "AuthorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
        "TokenEndpoint": "https://oauth2.googleapis.com/token",
        "ClientId": "your-google-oauth-client-id.apps.googleusercontent.com",
        "ClientSecret": "your-google-oauth-client-secret (store via user-secrets / key vault, never commit)",
        "Scope": "https://www.googleapis.com/auth/generative-language.retriever"
      },
      "Anthropic": {
        "_comment": "Anthropic does not currently publish a general-purpose OAuth2 flow for API key issuance \u2014 use the pasted-API-key connection method on the Providers screen for Anthropic instead. This block is left as a placeholder for if/when that changes; do not point it at a fabricated endpoint.",
        "AuthorizationEndpoint": null,
        "TokenEndpoint": null
      }
    },
    "Providers": {
      "Anthropic": {
        "ApiKey": "sk-ant-***  (store via user-secrets / key vault, never commit)"
      },
      "OpenAI": {
        "ApiKey": "sk-***"
      },
      "Google": {
        "ApiKey": "***"
      }
    },
    "Registration": {
      "RoleCodes": {
        "Operator": "SET_OPERATOR_REGISTRATION_CODE",
        "Auditor": "SET_AUDITOR_REGISTRATION_CODE",
        "Admin": "SET_ADMIN_REGISTRATION_CODE"
      }
    }
  }
}
