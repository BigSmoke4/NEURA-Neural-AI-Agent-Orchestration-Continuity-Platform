{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=neura;Username=neura;Password=replace_with_local_secret"
  },
  "Neura": {
    "DataProtectionKeyPath": "dp-keys",
    "Database": {
      "PasswordFile": ""
    },
    "DataProtection": {
      "CertificatePath": "",
      "CertificatePassword": "",
      "CertificatePasswordFile": ""
    },
    "MissionRecovery": {
      "HeartbeatIntervalSeconds": 20,
      "StaleRunningTimeoutSeconds": 300,
      "RecoverySweepIntervalSeconds": 30,
      "MaxMissionsPerSweep": 100
    },
    "EmailOutbox": {
      "PollIntervalSeconds": 5,
      "LeaseDurationSeconds": 300,
      "MaxAttempts": 12,
      "InitialRetryDelaySeconds": 5,
      "MaximumRetryDelaySeconds": 3600
    },
    "ForwardedHeaders": {
      "KnownProxies": []
    },
    "Security": {
      "CookieSecurePolicy": "SameAsRequest"
    },
    "NotifyEmailAddress": "",
    "PublicOrigin": "",
    "Redis": {
      "ConnectionString": ""
    },
    "RateLimiting": {
      "RedisKeyPrefix": "neura:rate-limit:v1"
    },
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "PasswordFile": "",
      "FromAddress": "",
      "EnableSsl": true
    },
    "OAuth": {
      "Google": {
        "Enabled": false,
        "_comment": "OAuth is disabled until provider-specific token use and refresh-token handling are implemented. Use an official API key instead."
      }
    },
    "Registration": {
      "RoleCodes": {
        "Operator": "",
        "Auditor": "",
        "Admin": ""
      }
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
