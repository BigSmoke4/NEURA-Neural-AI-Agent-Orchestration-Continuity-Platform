@model IEnumerable<Neura.Modules.Orchestration.Domain.Mission>
@{ ViewData["Title"] = "Mission Control"; }

<section class="panel" style="margin:1rem;">
    <h1 class="panel__title">Mission Control</h1>

    <form method="post" asp-action="Create" style="display:flex; gap:0.5rem; margin-bottom:1rem; flex-wrap:wrap;">
        <input name="title" placeholder="Mission title" required class="btn" style="flex:1; min-width:200px;" />
        <input name="objective" placeholder="Objective" required class="btn" style="flex:2; min-width:280px;" />
        <select name="mode" class="btn">
            <option value="Simulation">Simulation</option>
            <option value="Real">Real</option>
        </select>
        <button type="submit" class="btn btn--primary">Create &amp; Queue</button>
    </form>

    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr class="text-dim"><th>Title</th><th>Status</th><th>Mode</th><th>Created</th></tr>
        </thead>
        <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@m.Id">@m.Title</a></td>
                <td>@m.Status</td>
                <td>@m.Mode</td>
                <td>@m.CreatedAtUtc.ToString("u")</td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <p class="text-dim">No missions yet — create one above. Queued missions are picked up by the background MissionWorker, not run inline.</p>
    }
</section>
