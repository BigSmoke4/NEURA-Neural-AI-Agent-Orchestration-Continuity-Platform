@model IEnumerable<Neura.Modules.Orchestration.Domain.Mission>
@{ ViewData["Title"] = "Mission Control"; }
<section class="page-shell">
    <div class="panel">
        <div class="section-heading">
            <div>
                <p class="eyebrow">ORCHESTRATION / QUEUE</p>
                <h1 class="panel__title">Mission Control</h1>
            </div>
            <span class="badge">@Model.Count() RECENT</span>
        </div>

        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <form method="post" asp-action="Create" class="form-grid form-grid--mission">
            @Html.AntiForgeryToken()
            <label>Mission title
                <input name="title" maxlength="200" placeholder="Improve the checkout system" required class="form-control" />
            </label>
            <label>Execution mode
                <select name="mode" class="form-control">
                    <option value="Simulation">Simulation — deterministic, no provider credentials</option>
                    <option value="Real">Real — uses your connected providers and agents</option>
                </select>
            </label>
            <label>Project memory scope
                <select name="projectId" class="form-control">
                    <option value="">Create a new project scope</option>
                    @foreach (var project in ViewBag.ProjectChoices)
                    {
                        <option value="@project.ProjectId">Reuse: @project.Label (@project.ProjectId)</option>
                    }
                </select>
                <span class="text-dim">Reuse a project to retrieve its active memory in this mission.</span>
            </label>
            <label class="form-grid__wide">Objective
                <textarea name="objective" maxlength="2000" rows="3" placeholder="Describe the outcome, constraints, and acceptance criteria." required class="form-control"></textarea>
            </label>
            <div class="form-grid__wide form-actions">
                <button type="submit" class="btn btn--primary">＋ Create mission</button>
            </div>
        </form>

        <div class="table-scroll">
            <table class="data-table">
                <thead><tr><th>Title</th><th>Status</th><th>Mode</th><th>Created (UTC)</th></tr></thead>
                <tbody>
                @foreach (var mission in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@mission.Id">@mission.Title</a></td>
                        <td><span class="status-pill status-pill--@mission.Status.ToString().ToLowerInvariant()">@mission.Status</span></td>
                        <td>@mission.Mode</td>
                        <td>@mission.CreatedAtUtc.ToString("u")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <p class="empty-state">No missions yet. Create a Simulation mission for the deterministic handoff flow, or create a Real mission after connecting a provider and registering an agent.</p>
        }
    </div>
</section>
