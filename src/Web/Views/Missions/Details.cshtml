@model IEnumerable<Neura.Modules.Orchestration.Domain.AgentTask>
@{
    ViewData["Title"] = "Mission Details";
    var mission = (Neura.Modules.Orchestration.Domain.Mission)ViewBag.Mission;
}
<section class="page-shell panel mission-detail">
    <h1 class="panel__title">@mission.Title</h1>
    <p class="text-dim">@mission.Objective</p>
    <p><b>Status:</b> @mission.Status &nbsp; <b>Mode:</b> @mission.Mode</p>
    @if (TempData["ReferenceError"] is string referenceError)
    {
        <p class="validation-summary" role="alert">@referenceError</p>
    }

    @if (mission.Status == Neura.Modules.Orchestration.Domain.MissionStatus.Created)
    {
        <form method="post" asp-action="Start" asp-route-id="@mission.Id" class="form-actions">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn--primary">▶ Queue mission</button>
        </form>
    }
    else
    {
        <p class="status-note">This mission is @mission.Status. The durable worker queue prevents duplicate starts.</p>
    }

    @if (ViewBag.Output is string output && !string.IsNullOrWhiteSpace(output))
    {
        <section class="result-panel" aria-labelledby="mission-result-title">
            <h2 class="panel__title" id="mission-result-title">Mission result</h2>
            <pre class="result-panel__content">@output</pre>
        </section>
    }

    <h2 class="panel__title">Tasks</h2>
    @foreach (var task in Model)
    {
        <div class="panel task-detail">
            <p><b>@task.Title</b> — @task.Status</p>

            <h3 class="panel__title task-detail__heading">Reference material (@task.ReferenceMaterial.Count)</h3>
            @if (task.ReferenceMaterial.Any())
            {
                <ul>
                @foreach (var r in task.ReferenceMaterial)
                {
                    <li>
                        <b>@r.TrustLevel</b> @(r.IsTrusted ? "" : "(untrusted)") — @r.SourceDescription
                        <div class="text-dim reference-snippet">@(r.Text.Length > 300 ? r.Text[..300] + "…" : r.Text)</div>
                    </li>
                }
                </ul>
            }
            else
            {
                <p class="text-dim">None attached.</p>
            }

            @if (mission.Status == Neura.Modules.Orchestration.Domain.MissionStatus.Created)
            {
                <form method="post" asp-controller="TaskReference" asp-action="AttachFromUrl" class="form-actions form-actions--reference">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="taskId" value="@task.Id" />
                    <label class="form-actions__grow">Public reference URL
                        <input name="url" placeholder="https://example.com/reference (content is untrusted data)" required class="form-control" />
                    </label>
                    <button type="submit" class="btn">Attach reference</button>
                </form>
            }
        </div>
    }
</section>
