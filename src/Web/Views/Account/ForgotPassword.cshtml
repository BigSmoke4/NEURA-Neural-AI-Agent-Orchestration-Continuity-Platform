@{ ViewData["Title"] = "Forgot password"; }
<section class="panel account-panel account-panel--narrow">
    <h1 class="panel__title">Reset your password</h1>
    <p>Enter the email address on your account. If it is eligible, NEURA will send a time-limited reset link.</p>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="form-errors" role="alert">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }
    <form method="post" asp-action="ForgotPassword">
        @Html.AntiForgeryToken()
        <label class="panel__hint" for="reset-email">Email</label>
        <input id="reset-email" name="email" type="email" required autocomplete="email" class="btn account-input" />
        <button type="submit" class="btn btn--primary account-submit">Send reset link</button>
    </form>
    <p class="panel__hint"><a asp-action="Login">Return to sign in</a></p>
</section>
