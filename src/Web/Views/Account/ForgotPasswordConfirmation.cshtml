@{ ViewData["Title"] = "Password reset"; }
<section class="panel account-panel account-panel--narrow">
    <h1 class="panel__title">Check your email</h1>
    <p>If an eligible account matches that address, NEURA has sent a password-reset link. The link expires after three hours.</p>
    <p class="panel__hint"><a asp-action="Login">Return to sign in</a></p>
</section>
