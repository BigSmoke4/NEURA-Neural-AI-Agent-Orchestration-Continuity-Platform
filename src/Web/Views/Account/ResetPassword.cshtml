@{ ViewData["Title"] = "Choose a new password"; }
<section class="panel account-panel account-panel--narrow">
    <h1 class="panel__title">Choose a new password</h1>
    <p class="panel__hint">Use at least 10 characters, including an uppercase letter and a non-alphanumeric character.</p>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="form-errors" role="alert">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }
    <form method="post" asp-action="ResetPassword">
        @Html.AntiForgeryToken()
        <input type="hidden" name="userId" value="@ViewBag.UserId" />
        <input type="hidden" name="token" value="@ViewBag.Token" />
        <label class="panel__hint" for="reset-password">New password</label>
        <input id="reset-password" name="password" type="password" required minlength="10" autocomplete="new-password" class="btn account-input" />
        <label class="panel__hint" for="confirm-password">Confirm new password</label>
        <input id="confirm-password" name="confirmPassword" type="password" required minlength="10" autocomplete="new-password" class="btn account-input" />
        <button type="submit" class="btn btn--primary account-submit">Update password</button>
    </form>
</section>
