@{ ViewData["Title"] = "Sandbox Test"; }
<section class="panel" style="margin:1rem; max-width:800px;">
    <h1 class="panel__title">Sandbox Test (Admin only)</h1>
    <p class="panel__hint">
        Runs the submitted code inside an ephemeral, network-disabled Docker
        container via <code>DockerContainerSandbox</code> — the same
        abstraction a future coding agent's output would go through, if and
        when that's wired up. This screen is the only place in NEURA that
        ever executes code, and it always requires a human to press the
        button; nothing here is automatic. Requires a Docker daemon
        reachable from the host running NEURA.
    </p>
    <form method="post" asp-action="Run">
        @Html.AntiForgeryToken()
        <select name="language" class="btn" style="margin-bottom:0.5rem;">
            <option value="python">Python</option>
            <option value="node">Node.js</option>
            <option value="dotnet">.NET</option>
        </select>
        <textarea name="code" rows="8" class="btn" style="width:100%; font-family:var(--font-mono);" placeholder="print('hello from the sandbox')">@ViewBag.Code</textarea>
        <button type="submit" class="btn btn--primary" style="margin-top:0.5rem;">Run in sandbox</button>
    </form>

    @if (ViewBag.Result is not null)
    {
        var result = (Neura.Modules.Execution.Domain.SandboxExecutionResult)ViewBag.Result;
        <h2 class="panel__title" style="margin-top:1.5rem;">Result (@(result.Success ? "Success" : "Failed"), @result.Duration.TotalMilliseconds.ToString("F0")ms)</h2>
        <pre style="background:var(--color-bg-panel-raised); padding:1rem; border-radius:6px; white-space:pre-wrap;">@result.Output</pre>
        @if (result.Error is not null)
        {
            <pre style="color:var(--color-critical); white-space:pre-wrap;">@result.Error</pre>
        }
    }
</section>
