@model Neura.Modules.ContextManagement.Domain.ContextHandoffPackage
@{ ViewData["Title"] = "Context Package"; }
<section class="panel" style="margin:1rem; max-width:900px;">
    <h1 class="panel__title">Context Package</h1>
    <p><b>Mission:</b> @Model.Mission</p>
    <p><b>Current task:</b> @Model.CurrentTask</p>
    <p><b>Status:</b> @Model.Status</p>

    <div id="package-graph" style="height:420px; background:var(--color-bg-panel-raised); border:1px solid var(--color-border); border-radius:8px; margin:1rem 0;" role="img" aria-label="Package contents graph, grouped by category"></div>
    <p class="sr-only" id="package-graph-text-alt" aria-live="polite"></p>

    @{
        void RenderList(string label, List<string> items)
        {
            <h3 class="panel__title" style="margin-top:1rem;">@label</h3>
            if (items.Any())
            {
                <ul>@foreach (var i in items) { <li>@i</li> }</ul>
            }
            else
            {
                <p class="text-dim">None recorded.</p>
            }
        }
    }

    <h2 class="panel__title" style="margin-top:1.5rem;">Full detail (non-visual alternative to the graph above)</h2>
    @{ RenderList("Completed Work", Model.CompletedWork); }
    @{ RenderList("Remaining Work", Model.RemainingWork); }
    @{ RenderList("Decisions", Model.Decisions); }
    @{ RenderList("Constraints", Model.Constraints); }
    @{ RenderList("Files Changed", Model.FilesChanged); }
    @{ RenderList("Errors", Model.Errors); }
    @{ RenderList("Tests", Model.Tests); }
    @{ RenderList("Dependencies", Model.Dependencies); }
    @{ RenderList("Open Questions", Model.OpenQuestions); }
    @{ RenderList("Relevant Memory", Model.RelevantMemory); }
</section>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {
    const elements = @Html.Raw(ViewBag.ElementsJson);
    if (!elements.length) return;

    const cy = cytoscape({
        container: document.getElementById('package-graph'),
        elements: elements,
        style: [
            { selector: 'node', style: {
                'background-color': '#232830', 'border-width': 2, 'border-color': '#4c8dff',
                'label': 'data(label)', 'color': '#e6ecf1', 'font-size': 9,
                'text-valign': 'bottom', 'text-margin-y': 6, 'width': 26, 'height': 26,
                'text-wrap': 'wrap', 'text-max-width': '80px'
            }},
            { selector: 'edge', style: {
                'width': 1.5, 'line-color': '#2b3038', 'curve-style': 'bezier',
                'target-arrow-shape': 'triangle', 'target-arrow-color': '#2b3038'
            }}
        ],
        layout: { name: 'breadthfirst', directed: true, animate: false, spacingFactor: 1.2 }
    });

    cy.on('tap', 'node', (evt) => {
        document.getElementById('package-graph-text-alt').textContent = `Selected: ${evt.target.data('label')}`;
    });
});
</script>
}
