@model IEnumerable<Neura.Modules.ContextManagement.Domain.ContextHandoffPackage>
@{ ViewData["Title"] = "Context Explorer"; }
<section class="panel" style="margin:1rem;">
    <h1 class="panel__title">Context Explorer</h1>
    <p class="panel__hint">Structured handoff context packages built by the Context Continuity Engine, persisted in full. Click a package node to inspect it.</p>

    <div id="context-graph" data-elements="@ViewBag.ElementsJson" data-details-url="@Url.Action("Details", "Context")" style="height:380px; background:var(--color-bg-panel-raised); border:1px solid var(--color-border); border-radius:8px; margin-bottom:1rem;" role="img" aria-label="Mission to task to context package graph"></div>
    <p class="sr-only" id="context-graph-text-alt" aria-live="polite"></p>

    <table style="width:100%; border-collapse:collapse;">
        <thead><tr class="text-dim"><th>Mission</th><th>Task</th><th>Status</th><th>Created</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Mission</td><td>@p.CurrentTask</td><td>@p.Status</td><td>@p.CreatedAtUtc.ToString("u")</td>
                <td><a asp-action="Details" asp-route-id="@p.Id">Inspect</a></td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <p class="text-dim">No context packages recorded yet — run the Simulation Demo on the Brain screen to generate one.</p>
    }
</section>

@section Scripts {
    <script src="~/vendor/cytoscape/cytoscape.min.js" integrity="sha256-XztbUpVG1a8fxWKFkK8DO3RRGltveJ9fRoKEWGMii5E=" crossorigin="anonymous" asp-append-version="true"></script>
    <script src="~/js/context/context-index.js" asp-append-version="true"></script>
}
