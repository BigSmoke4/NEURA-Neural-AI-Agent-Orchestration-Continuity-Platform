@model IEnumerable<Neura.Modules.Observability.Domain.ExecutionEvent>
@{ ViewData["Title"] = "Execution Timeline"; }
<section class="panel" style="margin:1rem;">
    <h1 class="panel__title">Execution Timeline</h1>
    <form method="get" style="margin-bottom:1rem;">
        <select name="missionId" class="btn" onchange="this.form.submit()">
            <option value="">All missions</option>
            @foreach (var m in ViewBag.Missions)
            {
                <option value="@m.Id" selected="@(ViewBag.MissionId == m.Id)">@m.Title</option>
            }
        </select>
    </form>
    <ol style="font-family:var(--font-mono); font-size:0.8rem;">
        @foreach (var e in Model)
        {
            <li style="padding:0.4rem 0; border-bottom:1px solid var(--color-border);">
                <b>@e.TimestampUtc.ToString("HH:mm:ss")</b> — @e.EventType
                <span class="text-dim">(mission @e.MissionId)</span>
            </li>
        }
    </ol>
    @if (!Model.Any())
    {
        <p class="text-dim">No recorded events yet — run the Simulation Demo on the Brain screen, then come back here to replay it.</p>
    }
</section>
