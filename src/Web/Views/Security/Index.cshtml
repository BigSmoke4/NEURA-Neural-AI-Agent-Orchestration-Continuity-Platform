@{ ViewData["Title"] = "Security Center"; }
<section class="panel" style="margin:1rem;">
    <h1 class="panel__title">Security Center</h1>

    <h2 class="panel__title">Connected Credentials</h2>
    <p class="panel__hint">Only opaque credential references are ever shown — raw API keys are never stored or rendered anywhere in NEURA.</p>
    <table style="width:100%; border-collapse:collapse; margin-bottom:1.5rem;">
        <thead><tr class="text-dim"><th>Provider</th><th>Display Name</th><th>State</th><th>Credential Ref</th></tr></thead>
        <tbody>
        @foreach (var p in (IEnumerable<Neura.Modules.ProviderIntegration.Domain.AIProviderAccount>)ViewBag.Providers)
        {
            <tr>
                <td>@p.Kind</td>
                <td>@p.DisplayName</td>
                <td>@p.State</td>
                <td>@(p.ProtectedCredentialRef.Length > 6 ? $"••••{p.ProtectedCredentialRef[^4..]}" : "••••")</td>
            </tr>
        }
        </tbody>
    </table>

    <h2 class="panel__title">Audit Events</h2>
    <table style="width:100%; border-collapse:collapse;">
        <thead><tr class="text-dim"><th>When</th><th>User</th><th>Action</th><th>Target</th><th>Result</th><th>IP</th></tr></thead>
        <tbody>
        @foreach (var a in (IEnumerable<Neura.Modules.Observability.Domain.AuditLogEntry>)ViewBag.AuditLog)
        {
            <tr>
                <td>@a.TimestampUtc.ToString("u")</td>
                <td>@(a.UserId?.ToString() ?? "—")</td>
                <td>@a.Action</td>
                <td>@a.Target</td>
                <td>@a.Result</td>
                <td>@a.IpAddress</td>
            </tr>
        }
        </tbody>
    </table>
</section>
