@model IEnumerable<Neura.Modules.KnowledgeGraph.Domain.KnowledgeNode>
@{ ViewData["Title"] = "Knowledge Graph"; }
<section class="panel" style="margin:1rem;">
    <h1 class="panel__title">Project Knowledge Graph</h1>

    <div id="knowledge-graph" style="height:420px; background:var(--color-bg-panel-raised); border:1px solid var(--color-border); border-radius:8px;" role="img" aria-label="Interactive project knowledge graph"></div>
    <p class="sr-only" id="knowledge-graph-text-alt" aria-live="polite"></p>

    @if (!Model.Any())
    {
        <p class="text-dim" style="margin-top:1rem;">No knowledge nodes yet — the graph above will populate once KnowledgeNodes/KnowledgeEdges exist for a project.</p>
    }

    <h2 class="panel__title" style="margin-top:1.5rem;">Nodes (non-visual alternative)</h2>
    <table style="width:100%; border-collapse:collapse; margin-bottom:1.5rem;">
        <thead><tr class="text-dim"><th>Name</th><th>Type</th><th>Description</th></tr></thead>
        <tbody>
        @foreach (var n in Model)
        {
            <tr><td>@n.Name</td><td>@n.Type</td><td>@n.Description</td></tr>
        }
        </tbody>
    </table>

    <h2 class="panel__title">Edges</h2>
    <table style="width:100%; border-collapse:collapse;">
        <thead><tr class="text-dim"><th>From</th><th>Relationship</th><th>To</th></tr></thead>
        <tbody>
        @foreach (var e in (IEnumerable<Neura.Modules.KnowledgeGraph.Domain.KnowledgeEdge>)ViewBag.Edges)
        {
            <tr><td>@e.FromNodeId</td><td>@e.Type</td><td>@e.ToNodeId</td></tr>
        }
        </tbody>
    </table>
</section>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {
    const elements = @Html.Raw(ViewBag.ElementsJson);
    if (!elements.length) return;

    const cy = cytoscape({
        container: document.getElementById('knowledge-graph'),
        elements: elements,
        style: [
            { selector: 'node', style: {
                'background-color': '#232830', 'border-width': 2, 'border-color': '#4c8dff',
                'label': 'data(label)', 'color': '#e6ecf1', 'font-size': 9,
                'text-valign': 'bottom', 'text-margin-y': 6, 'width': 34, 'height': 34
            }},
            { selector: 'edge', style: {
                'width': 1.5, 'line-color': '#2b3038', 'curve-style': 'bezier',
                'target-arrow-shape': 'triangle', 'target-arrow-color': '#2b3038',
                'label': 'data(label)', 'font-size': 8, 'color': '#93a0ad'
            }}
        ],
        layout: { name: 'cose', animate: false }
    });

    cy.on('tap', 'node', (evt) => {
        const label = evt.target.data('label');
        document.getElementById('knowledge-graph-text-alt').textContent = `Selected node: ${label}`;
    });
});
</script>
}
