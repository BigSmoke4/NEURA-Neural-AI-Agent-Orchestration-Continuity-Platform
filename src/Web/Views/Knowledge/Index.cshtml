@model IEnumerable<Neura.Modules.KnowledgeGraph.Domain.KnowledgeNode>
@{
    ViewData["Title"] = "Knowledge Graph";
    var graphEdges = (IEnumerable<Neura.Modules.KnowledgeGraph.Domain.KnowledgeEdge>)ViewBag.Edges;
    var graphTruncated = (bool)ViewBag.GraphTruncated;
    var totalNodeCount = (int)ViewBag.TotalNodeCount;
    var totalEdgeCount = (int)ViewBag.TotalEdgeCount;
}
<section class="panel" style="margin:1rem;">
    <h1 class="panel__title">Project Knowledge Graph</h1>
    @if (graphTruncated)
    {
        <p class="status-note" role="status">Showing @Model.Count() of @totalNodeCount accessible nodes and @graphEdges.Count() of @totalEdgeCount edges among those displayed nodes. Additional graph records are omitted from this bounded overview.</p>
    }

    <div id="knowledge-graph" data-elements="@ViewBag.ElementsJson" style="height:420px; background:var(--color-bg-panel-raised); border:1px solid var(--color-border); border-radius:8px;" role="img" aria-label="Interactive project knowledge graph"></div>
    <p class="sr-only" id="knowledge-graph-text-alt" aria-live="polite"></p>

    @if (!Model.Any())
    {
        <p class="text-dim" style="margin-top:1rem;">No knowledge nodes yet — the graph above will populate once KnowledgeNodes/KnowledgeEdges exist for a project.</p>
    }

    <h2 class="panel__title" style="margin-top:1.5rem;">Nodes (non-visual alternative)</h2>
    <table style="width:100%; border-collapse:collapse; margin-bottom:1.5rem;">
        <thead><tr class="text-dim"><th>Name</th><th>Type</th><th>Description</th></tr></thead>
        <tbody>
        @foreach (var n in Model)
        {
            <tr><td>@n.Name</td><td>@n.Type</td><td>@n.Description</td></tr>
        }
        </tbody>
    </table>

    <h2 class="panel__title">Edges</h2>
    <table style="width:100%; border-collapse:collapse;">
        <thead><tr class="text-dim"><th>From</th><th>Relationship</th><th>To</th></tr></thead>
        <tbody>
        @foreach (var e in graphEdges)
        {
            <tr><td>@e.FromNodeId</td><td>@e.Type</td><td>@e.ToNodeId</td></tr>
        }
        </tbody>
    </table>
</section>

@section Scripts {
    <script src="~/vendor/cytoscape/cytoscape.min.js" integrity="sha256-XztbUpVG1a8fxWKFkK8DO3RRGltveJ9fRoKEWGMii5E=" crossorigin="anonymous" asp-append-version="true"></script>
    <script src="~/js/knowledge/knowledge-graph.js" asp-append-version="true"></script>
}
