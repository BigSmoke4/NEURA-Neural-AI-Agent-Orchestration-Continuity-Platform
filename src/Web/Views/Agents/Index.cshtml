@model IEnumerable<Neura.Modules.AgentManagement.Domain.Agent>
@{ ViewData["Title"] = "Agent Network"; }
<section class="panel" style="margin:1rem;">
    <h1 class="panel__title">Agent Network</h1>
    <table style="width:100%; border-collapse:collapse;">
        <thead><tr class="text-dim"><th>Name</th><th>Role</th><th>Status</th><th>Capabilities</th><th>Reliability</th><th>Enabled</th><th></th></tr></thead>
        <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@a.Id">@a.Name</a></td>
                <td>@a.Role</td>
                <td>@a.Status</td>
                <td>@string.Join(", ", a.Capabilities)</td>
                <td>@a.ReliabilityScore.ToString("P0")</td>
                <td>@(a.Enabled ? "Yes" : "No")</td>
                <td>
                    <form method="post" asp-action="Disable" asp-route-id="@a.Id">
                        <button class="btn btn--icon" type="submit">Disable</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    @if (!Model.Any())
    {
        <p class="text-dim">No agents yet. Agents created via the Simulation Demo or MissionWorker are in-memory only — add a Create form here bound to AgentsController.Create to persist real ones.</p>
    }
</section>
