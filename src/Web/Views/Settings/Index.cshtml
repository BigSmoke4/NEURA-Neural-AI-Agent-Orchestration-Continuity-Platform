@model Neura.Modules.ContextManagement.Domain.ContextThresholdOptions
@{ ViewData["Title"] = "Settings"; }
<section class="panel" style="margin:1rem; max-width:520px;">
    <h1 class="panel__title">Orchestration Settings</h1>
    <p class="panel__hint">These thresholds drive when the orchestration engine issues a Context Warning, Context Critical, or triggers a handoff. Configured in appsettings under <code>Neura:ContextThresholds</code> — this screen is read-only; wire a POST action to SettingsController to make it editable.</p>
    <table style="width:100%; border-collapse:collapse; margin-top:1rem;">
        <tr><td class="text-dim">Warning threshold</td><td>@Model.WarningThreshold.ToString("P0")</td></tr>
        <tr><td class="text-dim">Critical threshold</td><td>@Model.CriticalThreshold.ToString("P0")</td></tr>
        <tr><td class="text-dim">Exhaustion threshold</td><td>@Model.ExhaustionThreshold.ToString("P0")</td></tr>
    </table>
</section>
