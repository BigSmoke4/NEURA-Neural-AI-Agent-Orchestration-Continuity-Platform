@model IEnumerable<Neura.Modules.ProviderIntegration.Domain.AIProviderAccount>
@{ ViewData["Title"] = "Provider Management"; }
<section class="page-shell">
    <div class="panel">
        <p class="eyebrow">PROVIDER GATEWAY / CREDENTIALS</p>
        <h1 class="panel__title">Provider Management</h1>
        @if (TempData["ProviderError"] is string providerError)
        {
            <p class="validation-summary" role="alert">@providerError</p>
        }
        <p class="panel__hint">Connect your provider account through its official API. API keys are encrypted before storage and never displayed again. Provider and Agent are separate records.</p>

        <form method="post" asp-action="Connect" class="form-grid form-grid--provider">
            @Html.AntiForgeryToken()
            <label>Provider
                <select name="kind" class="form-control" aria-label="Provider">
                    <option>OpenAI</option><option>Anthropic</option><option>Google</option>
                </select>
            </label>
            <label>Display name <input name="displayName" maxlength="120" required class="form-control" /></label>
            <label class="form-grid__wide">API key
                <input name="apiKey" type="password" autocomplete="new-password" minlength="8" placeholder="Encrypted at rest; never shown again" required class="form-control" />
            </label>
            <div class="form-grid__wide form-actions"><button type="submit" class="btn btn--primary">Connect provider</button></div>
        </form>

        <p class="panel__hint">OAuth credentials are not yet enabled for AI execution because token refresh and provider-specific authorization are not implemented. Use an official provider API key until that adapter is configured; this avoids presenting a short-lived token as a durable connection.</p>

        <div class="table-scroll">
            <table class="data-table">
                <thead><tr><th>Account</th><th>Provider</th><th>State</th><th>Last health</th><th>Controls</th></tr></thead>
                <tbody>
                @foreach (var provider in Model)
                {
                    <tr>
                        <td>@provider.DisplayName</td><td>@provider.Kind</td><td>@provider.State</td>
                        <td>@(provider.LastHealthMessage ?? "—")</td>
                        <td class="provider-account-actions">
                            <form method="post" asp-action="Disconnect" asp-route-id="@provider.Id">
                                @Html.AntiForgeryToken()
                                <button class="btn btn--icon" type="submit">Disconnect</button>
                            </form>
                            <form method="post" asp-action="Rotate" asp-route-id="@provider.Id" class="provider-rotate-form">
                                @Html.AntiForgeryToken()
                                <input name="newApiKey" type="password" autocomplete="new-password" minlength="8" placeholder="Replacement key" class="form-control" aria-label="Replacement API key" />
                                <button class="btn btn--icon" type="submit">Rotate key</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (!Model.Any())
        {
            <p class="empty-state">No providers connected. Real Mode remains unavailable until you connect an account and configure an agent. NEURA never fabricates a real provider response.</p>
        }
    </div>
</section>
