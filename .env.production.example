# Copy to .env.production and replace every placeholder. Keep the destination
# .env.production file and all ./secrets/ files out of Git.
# Use immutable, reviewed image references (prefer @sha256 digests).
NEURA_IMAGE=REPLACE_WITH_NEURA_IMAGE_AT_SHA256_DIGEST
POSTGRES_IMAGE=REPLACE_WITH_POSTGRES_IMAGE_AT_SHA256_DIGEST

# File-backed Compose secrets. Files must exist and be access-controlled on
# the deployment host; Compose local-file secrets are not an encrypted vault.
# The web container uses UID 10001; on rootful Linux, assign the web secrets
# to that UID with mode 0400 (postgres_password may be read by root in Postgres).
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
NEURA_DP_CERTIFICATE_FILE=./secrets/neura-dp.pfx
NEURA_DP_CERTIFICATE_PASSWORD_FILE=./secrets/neura-dp-password

# Canonical HTTPS origin used to create email confirmation/password-reset links.
NEURA_PUBLIC_ORIGIN=https://neura.example.com
# Exact public hostnames; semicolon-delimited for ASP.NET Core AllowedHosts.
NEURA_ALLOWED_HOSTS=neura.example.com
# Exact source IP from which the application receives forwarded headers.
NEURA_TRUSTED_PROXY_IP=172.30.0.10

# SMTP is required in non-Development environments for identity email flows.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=neura@example.com
SMTP_PASSWORD_FILE=./secrets/smtp_password
SMTP_FROM_ADDRESS=neura@example.com

# Durable email outbox drain/retry policy (payloads are encrypted with the shared DP key ring).
EMAIL_OUTBOX_POLL_INTERVAL_SECONDS=5
EMAIL_OUTBOX_LEASE_DURATION_SECONDS=300
EMAIL_OUTBOX_MAX_ATTEMPTS=12
EMAIL_OUTBOX_INITIAL_RETRY_DELAY_SECONDS=5
EMAIL_OUTBOX_MAX_RETRY_DELAY_SECONDS=3600

WEB_HOST_PORT=8080
POSTGRES_DB=neura
POSTGRES_USER=neura
